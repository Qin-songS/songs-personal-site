# OpenAI Realtime (global channel)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Alibaba Cloud Model Studio / Bailian (China channel)
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_REALTIME_MODEL=qwen3.5-omni-flash-realtime
DASHSCOPE_REALTIME_VOICE=Ethan

# Routing and basic abuse protection
AI_PROVIDER_ORDER=openai,qwen
AI_SESSION_LIMIT=8

# Optional local proxy for OpenAI requests (Node.js 24.5+)
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,.maas.aliyuncs.com
